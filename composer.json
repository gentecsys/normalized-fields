{
	"name": "gentecsys/normalized-fields",
	"description": "NF: ACF-compatible custom fields stored in typed, pivot and lookup tables.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^9.6",
		"yoast/phpunit-polyfills": "^4.0.0",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpcompatibility/phpcompatibility-wp": "^2.1",
		"phpstan/phpstan": "^1.11 || ^2.0",
		"szepeviktor/phpstan-wordpress": "^1.3 || ^2.0",
		"php-stubs/wordpress-stubs": "^7.1"
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"sort-packages": true
	},
	"scripts": {
		"lint": "phpcs",
		"stan": "phpstan analyse --memory-limit=1G",
		"test": "phpunit"
	},
	"autoload": {
		"psr-4": {
			"NF\\": "src/"
		},
		"files": [
			"src/functions/nf.php"
		]
	}
}
