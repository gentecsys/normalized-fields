includes:
	- vendor/szepeviktor/phpstan-wordpress/extension.neon
parameters:
	level: 6
	# Runtime guards (PHP/WP version checks) are legitimate even when stubs say otherwise.
	treatPhpDocTypesAsCertain: false
	paths:
		- normalized-fields.php
		- uninstall.php
		- src
		- bench
	excludePaths:
		- lib (?)
	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
		- tests/stubs/wp-cli.php
